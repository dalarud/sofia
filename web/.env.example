# Databasen: anslutningssträngen från Supabase (Project Settings → Database → Connection pooling, Transaction).
DATABASE_URL=postgres://postgres@localhost:5433/dalarud

# Hemsidans adress, utan snedstreck på slutet. Används i länkar från Stripe och i e-post.
SITE_URL=http://localhost:3000

# Inloggning till administrationssidan. Skapa hashen med: npm run admin:password
ADMIN_EMAIL=sofia@studiodalarud.se
ADMIN_PASSWORD_HASH=
# Lång slumpad sträng som skyddar inloggningen, till exempel: openssl rand -base64 48
SESSION_SECRET=

# Stripe (Developers → API keys och Webhooks). Börja med testnycklar (sk_test_...).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Valfritt: skicka e-post (presentkort, guiden, fakturor) via Resend.
RESEND_API_KEY=
MAIL_FROM=Studio Dalarud <hej@studiodalarud.se>

# Endast lokalt: låtsaskassa utan Stripe, för att testa hela flödet.
STRIPE_MOCK=0
